<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>8447e5db-f4eb-499c-84f3-042fc4a4783a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="DotNetSecurityFocused.Tests/**" />
    <Compile Remove="DotNetSecurityFocused.Guardrails/**" />
    <Compile Remove="Tools/**" />
    <Content Remove="DotNetSecurityFocused.Tests/**" />
    <Content Remove="DotNetSecurityFocused.Guardrails/**" />
    <Content Remove="Tools/**" />
    <None Remove="DotNetSecurityFocused.Tests/**" />
    <None Remove="DotNetSecurityFocused.Guardrails/**" />
    <None Remove="Tools/**" />
    <EmbeddedResource Remove="DotNetSecurityFocused.Tests/**" />
    <EmbeddedResource Remove="DotNetSecurityFocused.Guardrails/**" />
    <EmbeddedResource Remove="Tools/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DotNetSecurityFocused.Guardrails\DotNetSecurityFocused.Guardrails.csproj" />
  </ItemGroup>

</Project>
