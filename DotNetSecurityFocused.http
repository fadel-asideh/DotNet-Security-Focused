@baseUrl = http://localhost:5029

# ===========================
# AUTH - Register
# ===========================

### Register an Admin user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "admin@test.com",
    "password": "Admin@123!",
    "ConfirmPassword": "Admin@123!",
    "roles": ["Admin"]
}

###

### Register a Manager user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "manager@test.com",
    "password": "Manager@123!",
    "ConfirmPassword": "Manager@123!",
    "roles": ["Manager"]
}

###

### Register a regular User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "user@test.com",
    "password": "User@123!",
    "ConfirmPassword": "User@123!",
    "roles": ["User"]
}

###

### Register a second regular User (needed later for the Orders IDOR check)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "user2@test.com",
    "password": "User2@123!",
    "ConfirmPassword": "User2@123!",
    "roles": ["User"]
}

###

### Register a user with multiple roles (Admin + Manager)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "adminmanager@test.com",
    "password": "AdminManager@123!",
    "ConfirmPassword": "AdminManager@123!",
    "roles": ["Admin", "Manager"]
}

###

### Register with invalid role → expect 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "test@test.com",
    "password": "Test@123!",
    "ConfirmPassword": "Test@123!",
    "roles": ["SuperAdmin"]
}

###

# ===========================
# AUTH - Login
# ===========================

### Login as Admin (copy "token" → paste into @adminToken below)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@test.com",
    "password": "Admin@123!"
}

###

### Login as Manager (copy "token" → paste into @managerToken below)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "manager@test.com",
    "password": "Manager@123!"
}

###

### Login as User (copy "token" → paste into @userToken below, copy "refreshToken" → paste into @userRefreshToken further down)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user@test.com",
    "password": "User@123!"
}

###

### Login as second User (copy "token" → paste into @user2Token below — needed for the Orders IDOR check)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user2@test.com",
    "password": "User2@123!"
}

###

### Login as Admin+Manager (copy "token" → paste into @adminManagerToken below)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "adminmanager@test.com",
    "password": "AdminManager@123!"
}

###

### Login with wrong password → expect 401
### (Task 5) Re-send this request rapidly 21+ times within 10 seconds to see the
### sliding-window rate limiter kick in — the 21st+ attempt should return 429.
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@test.com",
    "password": "WrongPassword!"
}

###

# ===========================
# Paste tokens here after login
# Access tokens expire after 15 minutes — re-run the matching login request above if a token stops working.
# ===========================

@adminToken = 
@managerToken = 
@userToken = 
@user2Token = 
@adminManagerToken = 
@userRefreshToken = 
# ===========================
# AUTH - Refresh Token
# ===========================

### Refresh with a valid refresh token → expect 200 with a NEW token pair
### Copy the new "refreshToken" from the response and replace @userRefreshToken above with it,
### or run the next request immediately to see reuse-rejection before rotating.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{userRefreshToken}}"
}

###

### Reuse the SAME refresh token again without updating @userRefreshToken → expect 401
### (rotation revokes a refresh token the moment it's used once, so replay fails)
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{userRefreshToken}}"
}

###

# ===========================
# AUTH - Logout
# ===========================

### Logout with a valid (not-yet-used) refresh token → expect 200
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
    "refreshToken": "{{userRefreshToken}}"
}

###

### Attempt to refresh again after logout, using the same token → expect 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
    "refreshToken": "{{userRefreshToken}}"
}

###

# ===========================
# SECRETS - No token (expect 401)
# ===========================

### No token → expect 401
GET {{baseUrl}}/secrets/admin

###

# ===========================
# SECRETS - Admin endpoint
# ===========================

### Admin hits admin endpoint → expect 200
GET {{baseUrl}}/secrets/admin
Authorization: Bearer {{adminToken}}

###

### User hits admin endpoint → expect 403
GET {{baseUrl}}/secrets/admin
Authorization: Bearer {{userToken}}

###

### Manager hits admin endpoint → expect 403
GET {{baseUrl}}/secrets/admin
Authorization: Bearer {{managerToken}}

###

# ===========================
# SECRETS - User endpoint
# ===========================

### User hits user endpoint → expect 200
GET {{baseUrl}}/secrets/user
Authorization: Bearer {{userToken}}

###

### Admin hits user endpoint → expect 403
GET {{baseUrl}}/secrets/user
Authorization: Bearer {{adminToken}}

###

# ===========================
# SECRETS - Manager endpoint
# ===========================

### Manager hits manager endpoint → expect 200
GET {{baseUrl}}/secrets/manager
Authorization: Bearer {{managerToken}}

###

### User hits manager endpoint → expect 403
GET {{baseUrl}}/secrets/manager
Authorization: Bearer {{userToken}}

###

# ===========================
# SECRETS - Admin OR Manager endpoint
# ===========================

### Admin hits admin-or-manager → expect 200
GET {{baseUrl}}/secrets/admin-or-manager
Authorization: Bearer {{adminToken}}

###

### Manager hits admin-or-manager → expect 200
GET {{baseUrl}}/secrets/admin-or-manager
Authorization: Bearer {{managerToken}}

###

### User hits admin-or-manager → expect 403
GET {{baseUrl}}/secrets/admin-or-manager
Authorization: Bearer {{userToken}}

###

# ===========================
# SECRETS - Admin AND Manager endpoint
# ===========================

### Admin+Manager user hits admin-and-manager → expect 200
GET {{baseUrl}}/secrets/admin-and-manager
Authorization: Bearer {{adminManagerToken}}

###

### Admin only hits admin-and-manager → expect 403
GET {{baseUrl}}/secrets/admin-and-manager
Authorization: Bearer {{adminToken}}

###

### Manager only hits admin-and-manager → expect 403
GET {{baseUrl}}/secrets/admin-and-manager
Authorization: Bearer {{managerToken}}

###

# ===========================
# PRODUCTS - Search (parameterized query demo)
# ===========================

### Legitimate search term → expect matching products
GET {{baseUrl}}/products/search?name=Widget

###

### SQL injection payload (x' OR '1'='1' -- ) → expect an EMPTY array
### The safe search method treats this as literal text, not executable SQL —
### compare this to ProductSearchService.SearchByNameVulnerableAsync, which is
### never wired to a route but is covered directly by SqlInjectionTests.
GET {{baseUrl}}/products/search?name=x%27%20OR%20%271%27%3D%271%27%20--%20

###

# ===========================
# ORDERS - Ownership is always derived from the token, never the request body
# (there is deliberately no "userId" field you can set here)
# ===========================

### Create an order as User → copy the returned "id" and paste it into @myOrderId below
POST {{baseUrl}}/orders
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
    "productName": "Widget",
    "quantity": 2,
    "totalPrice": 19.98
}

###

@myOrderId =

### Fetch your own order → expect 200
GET {{baseUrl}}/orders/{{myOrderId}}
Authorization: Bearer {{userToken}}

###

### Fetch the SAME order as a DIFFERENT authenticated user (IDOR check) → expect 404, not someone else's data
GET {{baseUrl}}/orders/{{myOrderId}}
Authorization: Bearer {{user2Token}}

###

# ===========================
# SECURITY HEADERS - manual check (Task 11)
# No dedicated endpoint for this — inspect the response HEADERS on any request
# above. Every response should carry X-Content-Type-Options, X-Frame-Options,
# and Content-Security-Policy. Strict-Transport-Security only appears when the
# app is called over https (not plain http on localhost).
# ===========================

# ===========================
# Health Check
# ===========================

### Health check → expect 200 Healthy
GET {{baseUrl}}/health
